<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- ✅ FIX #1: TargetFrameworks MIT Conditions wie im Standard-Template -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- ✅ FIX #2: OutputType hinzugefügt -->
		<OutputType>Exe</OutputType>
		
		<RootNamespace>NBH</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>CareCommunity</ApplicationTitle>
		<ApplicationId>com.companyname.nbh</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		
		<!-- ✅ FIX #3: ValidateXcodeVersion ENTFERNT (Standard = true) -->
		
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- ✅ FIX #4: iOS Debug - MtouchUseLlvm ENTFERNT (war True, muss False/weg sein) -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
		<MtouchLink>None</MtouchLink>
	</PropertyGroup>

	<!-- iOS Release - hier ist LLVM ok -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
		<PublishTrimmed>true</PublishTrimmed>
		<RunAOTCompilation>true</RunAOTCompilation>
		<MtouchUseLlvm>true</MtouchUseLlvm>
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<!-- iOS Codesigning -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
		<CodesignKey>Apple Development</CodesignKey>
		<CodesignProvision></CodesignProvision>
	</PropertyGroup>

	<!-- Test Platform Excludes für iOS -->
	<ItemGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
		<PackageReference Update="Microsoft.NET.Test.Sdk" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.TestHost" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.ObjectModel" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.VisualStudio.TestPlatform.Common" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.CommunicationUtilities" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.CrossPlatEngine" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.Utilities" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.PlatformAbstractions" ExcludeAssets="all" />
		<PackageReference Update="Microsoft.TestPlatform.CoreUtilities" ExcludeAssets="all" />
	</ItemGroup>

	<Target Name="RemoveTestPlatformAssemblies" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
			<ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'Microsoft.TestPlatform.ObjectModel'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.TestHost'&#xA;              OR '%(FileName)' == 'Microsoft.VisualStudio.TestPlatform.Common'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.CommunicationUtilities'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.CrossPlatEngine'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.Utilities'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.PlatformAbstractions'&#xA;              OR '%(FileName)' == 'Microsoft.TestPlatform.CoreUtilities'&#xA;              OR '%(FileName)' == 'testhost'" />
		</ItemGroup>
	</Target>

	<!-- Android Settings -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<PropertyGroup>
		<AndroidFixManifests>false</AndroidFixManifests>
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidJavaMaxHeapSize>1G</AndroidJavaMaxHeapSize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

