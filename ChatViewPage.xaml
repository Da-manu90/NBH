<?xml version="1.0" encoding="UTF-8"?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:NBH.Resources.ViewModels"
    xmlns:models="clr-namespace:NBH.Resources.Models"
    x:Class="NBH.ChatViewPage"
    Title="Chat-Uebersicht"
    Shell.NavBarIsVisible="False"
    Padding="12"
    x:DataType="viewModels:ChatViewPageViewModel"
    xmlns:controls="clr-namespace:NBH.Resources.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <VerticalStackLayout Spacing="10">
                <Border BackgroundColor="#F4FFFC"
                        StrokeThickness="0"
                        Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="💬"
                               FontSize="20"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Chats"
                                   Style="{StaticResource TitleStyle}"
                                   TextColor="#0D4037"/>
                            <Label Text="Aktuelle Unterhaltungen und ungelesene Nachrichten."
                                   Style="{StaticResource BodySmallStyle}"
                                   TextColor="#4A6A64"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <CollectionView x:Name="ChatsCollectionView"
                                ItemsSource="{Binding Chats}"
                                SelectionMode="Single"
                                VerticalOptions="FillAndExpand"
                                SelectionChanged="OnChatSelected">

                    <CollectionView.EmptyView>
                        <controls:EmptyStateView
                            IconSource="no_chats_illustration.svg"
                            Title="Noch keine Chats vorhanden."
                            Description="Beginne jetzt und schreibe jemanden eine Nachricht!"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PublicChat">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Löschen"
                                                   BackgroundColor="Red"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ChatViewPageViewModel}}, Path=ArchiveCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Stroke="#1A000000"
                                        StrokeThickness="1"
                                        Padding="10"
                                        Margin="0,4,0,4"
                                        BackgroundColor="#FCFFFE">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.07" Radius="10" Offset="0,3"/>
                                    </Border.Shadow>
                                    <Grid Padding="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Grid WidthRequest="58" HeightRequest="58"
                                              HorizontalOptions="Start" VerticalOptions="Center">
                                            <Border WidthRequest="58" HeightRequest="58"
                                                    Stroke="#15000000"
                                                    StrokeThickness="1"
                                                    Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="29"/>
                                                </Border.StrokeShape>
                                                <ff:CachedImage Source="{Binding PartnerImageUrl}"
                                                                Aspect="AspectFill"
                                                                HorizontalOptions="Fill"
                                                                VerticalOptions="Fill"
                                                                CacheDuration="7"
                                                                LoadingPlaceholder="profile_placeholder.png"
                                                                ErrorPlaceholder="profile_placeholder.png"
                                                                DownsampleToViewSize="True"/>
                                            </Border>
                                        </Grid>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding PartnerName}"
                                                   FontSize="16"
                                                   TextColor="#16211F"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="False">
                                                        <Setter Property="FontAttributes" Value="None" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Text="{Binding LastMessage}"
                                                   Style="{StaticResource BodyLargeStyle}"
                                                   TextColor="#666"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="False">
                                                        <Setter Property="FontAttributes" Value="None" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                                            <Label Text="{Binding LastMessageDate, StringFormat='{0:dd.MM HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="#7A7A7A"
                                                   HorizontalTextAlignment="End"/>
                                            <Border IsVisible="{Binding IsUnread}"
                                                    BackgroundColor="#00897B"
                                                    HorizontalOptions="End"
                                                    Padding="8,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="Neu"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="White"/>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <controls:BellControl
                x:Name="MyBell"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,10,10" />
        </Grid>

        <controls:CustomTabBar
            x:Name="MyTabBar"
            Grid.Row="1"
            SelectedIndex="3"/>
    </Grid>
</ContentPage>
