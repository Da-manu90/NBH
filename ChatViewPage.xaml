<?xml version="1.0" encoding="UTF-8"?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:NBH.Resources.ViewModels"
    xmlns:models="clr-namespace:NBH.Resources.Models"
    x:Class="NBH.ChatViewPage"
    Title="Chat-Ãœbersicht"
    Shell.NavBarIsVisible="False"
    Padding="10"
    x:DataType="viewModels:ChatViewPageViewModel"
    xmlns:controls="clr-namespace:NBH.Resources.Controls"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui">

    <!-- ============================================================
         Ã„USSERES GRID: Inhalt (Row 0) + TabBar (Row 1)
         ============================================================ -->
    <Grid RowDefinitions="*,Auto">

        <!-- ========================================================
             ROW 0: Gesamter Seiteninhalt
             ======================================================== -->
        <Grid Grid.Row="0">

            <VerticalStackLayout>

                <!-- Ãœberschrift -->
                <Label Text="Chats" 
                       Style="{StaticResource DisplayStyle}"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="0,0,0,10" />

                <!-- CollectionView: Liste aller laufenden Chats -->
                <CollectionView x:Name="ChatsCollectionView"
                                ItemsSource="{Binding Chats}"
                                SelectionMode="Single"
                                VerticalOptions="FillAndExpand"
                                SelectionChanged="OnChatSelected">

                    <CollectionView.EmptyView>
                        <controls:EmptyStateView
                            IconSource="no_chats_illustration.svg"
                            Title="Noch keine Chats"
                            Description="Wenn du einen Eintrag annimmst oder jemand deinen Eintrag annimmt, startet hier ein Chat."/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <!-- Hier deklarieren wir den Datentyp PublicChat -->
                        <DataTemplate x:DataType="models:PublicChat">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="LÃ¶schen"
                                                   BackgroundColor="Red"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ChatViewPageViewModel}}, Path=ArchiveCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Hintergrund mit vertikalem Farbverlauf -->
                                <Frame BorderColor="Black" Padding="7" CornerRadius="20" HasShadow="False">
                                    <Grid Padding="0" ColumnDefinitions="Auto,*,Auto">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#e3e3e3" Offset="0.0"/>
                                                <GradientStop Color="White" Offset="0.5"/>
                                                <GradientStop Color="#e3e3e3" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>

                                        <!-- Partner-Bild -->
                                        <Grid WidthRequest="70" HeightRequest="70" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Frame WidthRequest="70" HeightRequest="70" CornerRadius="35" BackgroundColor="Transparent" Padding="0" HasShadow="False">
                                                <ff:CachedImage Source="{Binding PartnerImageUrl}"
                                                                   Aspect="AspectFill"
                                                                   HorizontalOptions="Fill"
                                                                   VerticalOptions="Fill"
                                                                   CacheDuration="7"
                                                                   LoadingPlaceholder="profile_placeholder.png"
                                                                   ErrorPlaceholder="profile_placeholder.png"
                                                                   DownsampleToViewSize="True"/>
                                            </Frame>
                                        </Grid>

                                        <!-- Name & LastMessage -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0">
                                            <!-- PartnerName -->
                                            <Label Text="{Binding PartnerName}"
                                                   Style="{StaticResource TitleStyle}"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="False">
                                                        <Setter Property="FontAttributes" Value="None" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- LastMessage -->
                                            <Label Text="{Binding LastMessage}"
                                                   Style="{StaticResource BodyLargeStyle}"
                                                   TextColor="Gray">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="False">
                                                        <Setter Property="FontAttributes" Value="None" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- LastMessageDate -->
                                        <Label Grid.Column="2"
                                               Text="{Binding LastMessageDate, StringFormat='{0:dd.MM HH:mm}'}"
                                               Padding="10"
                                               Style="{StaticResource BodyStyle}"
                                               TextColor="Gray"
                                               HorizontalTextAlignment="End"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- BellControl als Overlay -->
            <controls:BellControl
                x:Name="MyBell"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,10,10" />

        </Grid>
        <!-- ========== ENDE ROW 0 ========== -->

        <!-- ========================================================
             ROW 1: CustomTabBar
             ======================================================== -->
        <controls:CustomTabBar
            x:Name="MyTabBar"
            Grid.Row="1"
            SelectedIndex="3"/>

    </Grid>
    <!-- ========== ENDE Ã„USSERES GRID ========== -->

</ContentPage>

