<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:NBH.Resources.ViewModels"
    x:Class="NBH.ProfilePage"
    x:DataType="viewModels:ProfilePageViewModel"
    xmlns:controls="clr-namespace:NBH.Resources.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    Shell.NavBarIsVisible="False">

    <!-- Hintergrund wird über den globalen ContentPage-Style gesteuert (Styles.xaml) -->

    <!-- ============================================================
         Ãƒâ€žUSSERES GRID: Inhalt (Row 0) + TabBar (Row 1)
         ============================================================ -->
    <Grid RowDefinitions="*,Auto">

        <!-- ========================================================
             ROW 0: Gesamter Seiteninhalt
             ======================================================== -->
        <Grid Grid.Row="0">

            <!-- Scrollbarer Hauptinhalt -->
            <ScrollView>
                <StackLayout Spacing="0" Padding="0">

                    <!-- ============================================
                         HEADER BANNER Ã¢â‚¬â€œ 3-Farben Gradient
                         Höhe ca. 1/5 des Viewports (kompakter)
                         ============================================ -->
                    <Grid MinimumHeightRequest="210">
                        <!-- Banner Hintergrund -->
                        <Border StrokeThickness="0" Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,0,36,36"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#87ffe9" Offset="0.0"/>
                                    <GradientStop Color="#00927f" Offset="0.5"/>
                                    <GradientStop Color="#87ffe9" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#006b5a" Opacity="0.7" Radius="30" Offset="0,12"/>
                            </Border.Shadow>
                        </Border>

                        <!-- Settings Button oben rechts -->
                        <ImageButton Source="settings.png"
                                     Command="{Binding NavigateToSettingsCommand}"
                                     WidthRequest="32" HeightRequest="32"
                                     Margin="0,48,20,0"
                                     HorizontalOptions="End"
                                     VerticalOptions="Start"
                                     BackgroundColor="Transparent">
                            <ImageButton.Shadow>
                                <Shadow Brush="Black" Opacity="0.3" Radius="5" Offset="0,2"/>
                            </ImageButton.Shadow>
                        </ImageButton>

                        <!-- Profilbild + Name + Sterne – kompakt im Banner -->
                        <StackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="4"
                                     Margin="0,4,0,8">

                            <!-- PROFILBILD -->
                            <Grid HeightRequest="90"
                                  WidthRequest="90"
                                  HorizontalOptions="Center">
                                <Border Stroke="White"
                                        StrokeThickness="3.5"
                                        WidthRequest="90"
                                        HeightRequest="90"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,4"/>
                                    </Border.Shadow>
                                    <ff:CachedImage Source="{Binding ProfileImageUrl}"
                                                   x:Name="ProfileImage"
                                                   Aspect="AspectFill"
                                                   HeightRequest="90"
                                                   WidthRequest="90"
                                                   CacheDuration="7"
                                                   LoadingPlaceholder="profile_placeholder.png"
                                                   ErrorPlaceholder="profile_placeholder.png"
                                                   DownsampleToViewSize="True">
                                        <ff:CachedImage.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProfileImageTapped"/>
                                        </ff:CachedImage.GestureRecognizers>
                                    </ff:CachedImage>
                                </Border>
                            </Grid>

                            <!-- BENUTZERNAME -->
                            <Label Text="{Binding Username}"
                                   Style="{StaticResource TitleLargeStyle}"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   Margin="0,0,0,0"/>

                            <!-- BEWERTUNG (Sterne + Anzahl) -->
                            <StackLayout x:Name="RatingContainer"
                                         Orientation="Vertical"
                                         HorizontalOptions="Center"
                                         Spacing="2"
                                         Margin="0,0,0,0">
                                
                                <controls:StarRatingControl
                                    x:Name="ProfileStarRating"
                                    Rating="{Binding FinalRating}"
                                    RatingCount="{Binding FinalRatingCount}"
                                    IsInteractive="False"
                                    HeightRequest="30"
                                    HorizontalOptions="Center"/>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToRatingPageCommand}"
                                                          CommandParameter="{Binding CurrentUserId}"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                        </StackLayout>
                    </Grid>

                    <!-- ============================================
                         KARTEN-BEREICH Ã¢â‚¬â€œ mehr Abstand zum Banner
                         ============================================ -->
                    <StackLayout Spacing="12" Padding="16,24,16,16">

                        <!-- ========== KARTE: WOHNORT ========== -->
                        <Border BackgroundColor="#CCffffff"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <StackLayout Spacing="8">
                                <Label Text="Wohnort"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"/>
                                <Border BackgroundColor="#E6ffffff"
                                        Stroke="#3300897b"
                                        StrokeThickness="1"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding Wohnort}"
                                           FontSize="16"
                                           Placeholder="Wohnort eingeben"
                                           PlaceholderColor="#ACACAC"
                                           Margin="12,6"/>
                                </Border>
                            </StackLayout>
                        </Border>

                        <!-- ========== KARTE: ÜBER MICH ========== -->
                        <Border BackgroundColor="#CCffffff"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <StackLayout Spacing="8">
                                <Label Text="Über mich"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"/>
                                <Border BackgroundColor="#E6ffffff"
                                        Stroke="#3300897b"
                                        StrokeThickness="1"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Editor Text="{Binding UeberMich}"
                                            FontSize="15"
                                            Placeholder="Hier kannst du etwas ÃƒÂ¼ber dich schreiben"
                                            PlaceholderColor="#ACACAC"
                                            AutoSize="TextChanges"
                                            MaxLength="200"
                                            Margin="12,6"/>
                                </Border>
                            </StackLayout>
                        </Border>

                        <!-- ========== KARTE: ABZEICHEN ========== -->
                        <Border BackgroundColor="#CCffffff"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <StackLayout Spacing="8">
                                <Label Text="Abzeichen"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"/>
                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            AlignItems="Start"
                                            JustifyContent="Start">
                                    <Border BackgroundColor="Transparent"
                                            StrokeThickness="0"
                                            Padding="6,3"
                                            Margin="0,0,6,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#e0f7fa" Offset="0"/>
                                                <GradientStop Color="#b2ebf2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="Keine Abzeichen"
                                               FontSize="12"
                                               TextColor="#00695c"/>
                                    </Border>
                                </FlexLayout>
                            </StackLayout>
                        </Border>

                        <!-- ========== KARTE: QUALIFIKATIONEN ========== -->
                        <Border BackgroundColor="#CCffffff"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <StackLayout Spacing="8">
                                <Label Text="Qualifikationen"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"/>
                                <Border BackgroundColor="#E6ffffff"
                                        Stroke="#3300897b"
                                        StrokeThickness="1"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Editor Text="{Binding Qualifikationen}"
                                            FontSize="15"
                                            Placeholder="Berufliche Qualifikationen eingeben"
                                            PlaceholderColor="#ACACAC"
                                            AutoSize="TextChanges"
                                            Margin="12,6"/>
                                </Border>
                            </StackLayout>
                        </Border>



                        <!-- ========== PROFIL SPEICHERN BUTTON ========== -->
                        <Frame x:Name="SaveProfileFrame"
                               BackgroundColor="Transparent"
                               CornerRadius="25"
                               HasShadow="False"
                               Padding="0"
                               HeightRequest="52"
                               Margin="0,8,0,0">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00d2a8" Offset="0.0"/>
                                    <GradientStop Color="#00897b" Offset="0.5"/>
                                    <GradientStop Color="#00695c" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Frame.Shadow>
                                <Shadow Brush="#00897b" Opacity="0.45" Radius="16" Offset="0,6"/>
                            </Frame.Shadow>
                            <Label Text="Profil speichern"
                                   TextColor="White"
                                   Style="{StaticResource BodyLargeStyle}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SaveProfileAsyncCommand}"
                                                      Tapped="OnSaveProfileTapped"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <!-- ========== DATENSCHUTZ BUTTON (UNTER PROFIL SPEICHERN) ========== -->
                        <Border BackgroundColor="#66ffffff"
                                Stroke="#4000897b"
                                StrokeThickness="1.5"
                                HeightRequest="44"
                                Margin="0,8,0,0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Datenschutz"
                                   Style="{StaticResource BodySmallStyle}"
                                   FontAttributes="Bold"
                                   TextColor="#00695c"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- ========== ZWEI GHOST-BUTTONS NEBENEINANDER ========== -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,0">

                            <!-- Passwort ändern -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#66ffffff"
                                    Stroke="#4000897b"
                                    StrokeThickness="1.5"
                                    HeightRequest="44"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetPasswordCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#x1F511; Passwort"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Qualifikationen verifizieren -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#66ffffff"
                                    Stroke="#4000897b"
                                    StrokeThickness="1.5"
                                    HeightRequest="44"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SendFileByEmailCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#x2713; Verifizieren"
                                       Style="{StaticResource BodySmallStyle}"
                                       FontAttributes="Bold"
                                       TextColor="#00695c"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- ========== ABMELDEN BUTTON (Roter Farbverlauf) ========== -->
                        <Border StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                HorizontalOptions="FillAndExpand"
                                Margin="30,8,30,20">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.4" Radius="10" Offset="0,4"/>
                            </Border.Shadow>
                            <Frame CornerRadius="22"
                                   HasShadow="False"
                                   Padding="0"
                                   HeightRequest="48"
                                   HorizontalOptions="FillAndExpand">
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#ff8383" Offset="0.0"/>
                                        <GradientStop Color="#510000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <Label Text="Abmelden"
                                       TextColor="White"
                                       Style="{StaticResource BodyLargeStyle}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LogoutCommand}"
                                                          NumberOfTapsRequired="1"
                                                          Tapped="Logout_Tapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Border>

                    </StackLayout>
                    <!-- Ende Karten-Bereich -->

                </StackLayout>
            </ScrollView>

            <!-- ========== OVERLAY: Upload-Fortschritt ========== -->
            <Grid x:Name="OverlayPanel"
                  BackgroundColor="#80000000"
                  IsVisible="{Binding IsUploading}"
                  RowDefinitions="*,Auto,*"
                  ColumnDefinitions="*,Auto,*">
                <StackLayout Grid.Row="1" Grid.Column="1"
                             Spacing="20"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
                    <Label Text="Profilbild wird geladen..."
                           FontSize="Large"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Border Padding="2"
                            BackgroundColor="Black"
                            HeightRequest="14"
                            WidthRequest="200"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <SolidColorBrush Color="White"/>
                        </Border.Stroke>
                        <ProgressBar Progress="{Binding UploadProgress}"
                                     ProgressColor="#35c4d8"
                                     BackgroundColor="Black"
                                     HeightRequest="10"
                                     HorizontalOptions="FillAndExpand"/>
                    </Border>
                </StackLayout>
            </Grid>

            <!-- Loading Overlay für Profil-Speichern etc. -->
            <controls:LoadingOverlay x:Name="ProfileLoadingOverlay"
                                     Grid.RowSpan="99"
                                     LoadingText="Profil wird gespeichert..."
                                     IsVisible="{Binding IsBusy}"/>

            <!-- Bell Control -->
            <controls:BellControl
                x:Name="MyBell"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,10,10"/>

        </Grid>
        <!-- ========== ENDE ROW 0 ========== -->

        <!-- ========================================================
             ROW 1: CustomTabBar
             ======================================================== -->
        <controls:CustomTabBar
            x:Name="MyTabBar"
            Grid.Row="1"
            SelectedIndex="0"/>

    </Grid>
    <!-- ========== ENDE Ãƒâ€žUSSERES GRID ========== -->

</ContentPage>

