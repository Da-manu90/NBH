<?xml version="1.0" encoding="utf-8" ?>
<mopup:PopupPage
    x:Class="NBH.Resources.Views.StatusBannerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopup="clr-namespace:Mopups.Pages;assembly=Mopups"
    BackgroundColor="#01000000"
    CloseWhenBackgroundIsClicked="False"
    HasSystemPadding="False">

    <Grid Padding="14,0,14,22">
        <Border
            x:Name="BannerCard"
            VerticalOptions="End"
            Padding="18,16"
            BackgroundColor="#1FA34A"
            Stroke="#FFFFFFFF"
            StrokeThickness="1.5"
            TranslationY="240"
            Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#99000000" Opacity="0.55" Radius="22" Offset="0,8" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border
                    WidthRequest="30"
                    HeightRequest="30"
                    BackgroundColor="#33FFFFFF"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Label
                        x:Name="IconLabel"
                        Text="+"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        x:Name="TitleLabel"
                        Text="Erfolg"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White" />
                    <Label
                        x:Name="MessageLabel"
                        Text="Aktion erfolgreich."
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        TextColor="White" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="2"
                    Padding="10,6"
                    BackgroundColor="#22FFFFFF"
                    Stroke="#55FFFFFF"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDismissTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="OK"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</mopup:PopupPage>
