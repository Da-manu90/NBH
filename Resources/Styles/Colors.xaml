<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->
    <!-- Dunkles Pastellblau -->
    <Color x:Key="TabBarSelectedColor">#318AC0</Color>
    
    <Color x:Key="HeaderBackgroundColor">#5A9CA5</Color>
    <Color x:Key="InputBackgroundColor">#F5F5F5</Color>
    <Color x:Key="ButtonBackgroundColor">#82A9C1</Color>
    <Color x:Key="SeparatorColor">#E0E0E0</Color>
    <Color x:Key="ListBackgroundColor">#DFF3F4</Color>
    <Color x:Key="TextColorBlack">#000000</Color>
    <Color x:Key="TextColorWhite">#FFFFFF</Color>

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- NBH Design-Tokens V2: Anthrazit + Eisgrün                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Anthrazit-Skala -->
    <Color x:Key="AnthrazitUltraLight">#f0f0f0</Color>
    <Color x:Key="AnthrazitLight">#8a8a8a</Color>
    <Color x:Key="AnthrazitMid">#6b6b6b</Color>
    <Color x:Key="AnthrazitBase">#4b4b4b</Color>
    <Color x:Key="AnthrazitDark">#333333</Color>
    <Color x:Key="AnthrazitDeep">#1e1e1e</Color>

    <!-- Akzent-Farben (Eisgrün / Teal) -->
    <Color x:Key="AccentLight">#e4f8f5</Color>
    <Color x:Key="AccentMid">#a8e6df</Color>
    <Color x:Key="AccentPrimary">#00897b</Color>
    <Color x:Key="AccentBright">#00d2a8</Color>

    <!-- Seiten-Hintergrund -->
    <Color x:Key="PageBackgroundStart">#e4f8f5</Color>
    <Color x:Key="PageBackgroundMid">#6b6b6b</Color>
    <Color x:Key="PageBackgroundEnd">#4b4b4b</Color>
    <Color x:Key="PageBackgroundStartDark">#2a2a2a</Color>
    <Color x:Key="PageBackgroundMidDark">#1e1e1e</Color>
    <Color x:Key="PageBackgroundEndDark">#121212</Color>

    <!-- Surface Colors -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#2d2d2d</Color>
    <Color x:Key="SurfaceElevatedLight">#f7f7f7</Color>
    <Color x:Key="SurfaceElevatedDark">#383838</Color>
    <Color x:Key="CardOnAnthrazit">#FFFFFF</Color>
    <Color x:Key="CardOnAnthrazitDark">#2d2d2d</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryLight">#1A1A1A</Color>
    <Color x:Key="TextPrimaryDark">#F0F0F0</Color>
    <Color x:Key="TextSecondaryLight">#666666</Color>
    <Color x:Key="TextSecondaryDark">#A0A0A0</Color>
    <Color x:Key="TextMutedLight">#999999</Color>
    <Color x:Key="TextMutedDark">#707070</Color>

    <!-- Semantische Farben -->
    <Color x:Key="ErrorColor">#E53935</Color>
    <Color x:Key="SuccessColor">#43A047</Color>
    <Color x:Key="WarningColor">#FB8C00</Color>

</ResourceDictionary>
