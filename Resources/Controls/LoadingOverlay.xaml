<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NBH.Resources.Controls.LoadingOverlay"
             IsVisible="False"
             InputTransparent="False">

    <!-- Glassmorphism-Hintergrund (Weiss-Transparent) -->
    <Grid BackgroundColor="#40FFFFFF">

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="280"
                HeightRequest="180"
                BackgroundColor="#C0FFFFFF"
                Padding="32"
                StrokeThickness="1"
                Stroke="#80FFFFFF">
            <!-- Glassmorphism: Abgerundete Ecken und weicher Schatten -->
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="White" Opacity="0.6" Radius="40" Offset="0,0"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="16"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <!-- Spinner -->
                <ActivityIndicator x:Name="Spinner"
                                   IsRunning="True"
                                   Color="#00897b"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   HorizontalOptions="Center"/>

                <!-- Dynamischer Lade-Text -->
                <Label x:Name="LoadingLabel"
                       Text="Bitte warten..."
                       FontSize="15"
                       TextColor="#4b4b4b"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentView>
