<?xml version="1.0" encoding="utf-8" ?>
<!--
    EntryCard.xaml – Polished Karte für die Eintrags-Liste
-->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:NBH.Resources.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="NBH.Resources.Controls.EntryCard"
    x:DataType="models:EntryItem"
    Padding="16,6">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
    </ContentView.Resources>

    <Border
        x:Name="CardRoot"
        BackgroundColor="White"
        StrokeThickness="0"
        Padding="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.08" Radius="16" Offset="0,4"/>
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,6,*" ColumnSpacing="0">

            <!-- BILD-VORSCHAU (LINKS) -->
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    WidthRequest="80"
                    HeightRequest="80"
                    Margin="10,10,0,10"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <!-- Bild wenn vorhanden -->
                <ff:CachedImage Source="{Binding event_image_url}"
                                Aspect="AspectFill"
                                IsVisible="{Binding event_image_url, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                CacheDuration="7"
                                LoadingPlaceholder="placeholder_event.png"
                                ErrorPlaceholder="placeholder_event.png"
                                DownsampleToViewSize="True"/>
            </Border>

            <!-- AKZENT-STREIFEN (MITTE als Trennlinie) -->
            <BoxView
                x:Name="AccentBar"
                Grid.Column="1"
                BackgroundColor="#00897b"/>

            <!-- KARTEN-INHALT (RECHTS) -->
            <VerticalStackLayout
                Grid.Column="2"
                Padding="16,14"
                Spacing="6">

                <!-- Obere Zeile: Kategorie-Chip + Datum -->
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Chip: Anfrage oder Angebot -->
                    <Border
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        Padding="10,4"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8F8F5" Offset="0"/>
                                <GradientStop Color="#D0F2EC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label
                            x:Name="CategoryLabel"
                            Text="{Binding category}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#00897b"/>
                    </Border>

                    <!-- Datum -->
                    <Label
                        Grid.Column="1"
                        Text="{Binding created_date, StringFormat='{0:dd.MM.yy}'}"
                        FontSize="11"
                        TextColor="#AAAAAA"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Titel -->
                <Label
                    Text="{Binding title}"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"/>

                <!-- Beschreibung -->
                <Label
                    Text="{Binding description}"
                    FontSize="14"
                    TextColor="#666666"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"/>

                <!-- Untere Zeile: Standort -->
                <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                    <Label
                        Text="📍"
                        FontSize="12"
                        VerticalOptions="Center"/>
                    <Label
                        Text="{Binding location, FallbackValue='Kein Standort'}"
                        FontSize="12"
                        TextColor="#999999"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
