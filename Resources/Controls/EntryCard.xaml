<?xml version="1.0" encoding="utf-8" ?>
<!--
    EntryCard.xaml – Polished Karte für die Eintrags-Liste
-->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:NBH.Resources.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Class="NBH.Resources.Controls.EntryCard"
    x:DataType="models:EntryItem"
    Padding="16,8">

    <Border x:Name="CardRoot"
            BackgroundColor="#F8FFFD"
            Stroke="#12000000"
            StrokeThickness="1"
            Padding="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.12" Radius="12" Offset="0,4"/>
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,6,*" ColumnSpacing="0">

            <!-- BILD-VORSCHAU (LINKS) -->
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    WidthRequest="84"
                    HeightRequest="84"
                    Margin="12,12,0,12"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid>
                    <Image Source="placeholder_event.png"
                           Aspect="AspectFill"/>
                    <ff:CachedImage Source="{Binding event_image_url}"
                                    Aspect="AspectFill"
                                    CacheDuration="7"
                                    LoadingPlaceholder="placeholder_event.png"
                                    ErrorPlaceholder="placeholder_event.png"
                                    DownsampleToViewSize="True">
                        <ff:CachedImage.Triggers>
                            <DataTrigger TargetType="ff:CachedImage"
                                         Binding="{Binding event_image_url}"
                                         Value="">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                            <DataTrigger TargetType="ff:CachedImage"
                                         Binding="{Binding event_image_url}"
                                         Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </ff:CachedImage.Triggers>
                    </ff:CachedImage>
                </Grid>
            </Border>

            <!-- AKZENT-STREIFEN (MITTE als Trennlinie) -->
            <BoxView
                x:Name="AccentBar"
                Grid.Column="1"
                BackgroundColor="#00897b"/>

            <!-- KARTEN-INHALT (RECHTS) -->
            <VerticalStackLayout Grid.Column="2"
                                 Padding="16,12"
                                 Spacing="8">

                <!-- Obere Zeile: Kategorie-Chip + Datum -->
                <Grid ColumnDefinitions="Auto,8,Auto,*,Auto">

                    <!-- Chip: Anfrage oder Angebot -->
                    <Border Grid.Column="0"
                            HorizontalOptions="Start"
                            Padding="10,4"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8F8F5" Offset="0"/>
                                <GradientStop Color="#D0F2EC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label
                            x:Name="CategoryLabel"
                            Text="{Binding category}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#00897b"/>
                    </Border>

                    <!-- Event type -->
                    <Border Grid.Column="2"
                            HorizontalOptions="Start"
                            Padding="10,4"
                            StrokeThickness="0"
                            BackgroundColor="#EEF3FF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding event_type}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#2E4A8A"/>
                    </Border>

                    <!-- CTA chip -->
                    <Border Grid.Column="4"
                            HorizontalOptions="End"
                            Padding="10,4"
                            StrokeThickness="0"
                            BackgroundColor="#00d2a8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="Details"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="White"/>
                    </Border>
                </Grid>

                <!-- Titel -->
                <Label
                    Text="{Binding title}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"/>

                <!-- Beschreibung -->
                <Label
                    Text="{Binding description}"
                    FontSize="13"
                    TextColor="#5A6663"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"/>

                <!-- Untere Zeile: Metadata -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,2,0,0">
                    <Label Grid.Column="0"
                           Text="{Binding location, StringFormat='📍 {0}'}"
                           FontSize="11"
                           TextColor="#7A8784"
                           LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="1"
                           Text="{Binding created_date, StringFormat='{0:dd.MM}'}"
                           FontSize="11"
                           TextColor="#7A8784"/>
                    <Label Grid.Column="2"
                           Text="{Binding max_participants, StringFormat='👥 {0}'}"
                           FontSize="11"
                           TextColor="#7A8784"/>
                </Grid>

            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
