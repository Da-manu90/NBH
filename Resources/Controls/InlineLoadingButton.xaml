<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NBH.Resources.Controls.InlineLoadingButton"
             x:Name="this">

    <Border StrokeThickness="0"
            HeightRequest="54"
            BackgroundColor="{Binding ButtonColor, Source={x:Reference this}}"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRectangle="27"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{Binding ButtonColor, Source={x:Reference this}}" Opacity="0.4" Radius="12" Offset="0,4"/>
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" Command="{Binding Command, Source={x:Reference this}}" CommandParameter="{Binding CommandParameter, Source={x:Reference this}}"/>
        </Border.GestureRecognizers>

        <Grid>
            <!-- Normaler Text -->
            <Label Text="{Binding Text, Source={x:Reference this}}"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsLoading, Source={x:Reference this}, Converter={StaticResource InverseBooleanConverter}}"/>

            <!-- Lade-Spinner -->
            <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference this}}"
                               IsVisible="{Binding IsLoading, Source={x:Reference this}}"
                               Color="White"
                               WidthRequest="28"
                               HeightRequest="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>
