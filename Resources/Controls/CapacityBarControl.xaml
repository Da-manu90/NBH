<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NBH.Resources.Controls"
             x:Class="NBH.Resources.Controls.CapacityBarControl">
    
    <StackLayout Spacing="5" Margin="0,5">
        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,2">
            <Label x:Name="ParticipantsLabel" Text="Teilnehmer" FontSize="14" FontAttributes="Bold" Grid.Column="0" TextColor="#444" />
            <Label x:Name="CountLabel" Text="0 von 0" FontSize="14" Grid.Column="1" TextColor="Gray" />
        </Grid>
        
        <Border HeightRequest="12" Padding="0" StrokeThickness="0" BackgroundColor="#E0E0E0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <Grid>
                <!-- Background is E0E0E0 -->
                <BoxView x:Name="FillBox" BackgroundColor="#0066a5" HorizontalOptions="Start" WidthRequest="0" />
            </Grid>
        </Border>

        <controls:AvatarStackControl x:Name="AvatarStack" Margin="0,8,0,0" />
    </StackLayout>
</ContentView>
