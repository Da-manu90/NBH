<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="NBH.Resources.Controls.BellControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    BackgroundColor="Transparent"
    HorizontalOptions="End"
    VerticalOptions="End"
    Margin="0,0,10,10">

    <AbsoluteLayout
        WidthRequest="72"
        HeightRequest="72">

        <!-- Hintergrund (Border) -->
        <Border
            x:Name="BellBackgroundBorder"
            StrokeThickness="5"
            AbsoluteLayout.LayoutBounds="0,0,72,72"
            AbsoluteLayout.LayoutFlags="None"
            BackgroundColor="Transparent">

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0.0" />
                    <GradientStop Color="#00b6ff" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00b6ff" Offset="0.0" />
                    <GradientStop Color="Black" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.3"
                    Offset="5,5"
                    Radius="10" />
            </Border.Shadow>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
        </Border>

        <!-- Glocke und Badge innerhalb des Hintergrunds -->
        <AbsoluteLayout
            AbsoluteLayout.LayoutBounds="0.5,0.5,72,72"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            BackgroundColor="Transparent">

            <!-- Animiertes GIF: standardmÃ¤ÃŸig unsichtbar -->
            <ff:CachedImage
            x:Name="BellGif"
            Source="bell_animation.gif"
            Aspect="AspectFit"
            WidthRequest="72"
            HeightRequest="72"
            IsVisible="False" />

                <!-- Normale PNG-Glocke -->
            <ImageButton
                x:Name="BellButton"
                Source="bell.png"
                WidthRequest="72"
                HeightRequest="72"
                BackgroundColor="Transparent"
                Clicked="OnBellClicked" />

            <!-- Badge -->
            <!-- Badge -->
            <Border
                x:Name="NotificationBadgeFrame"
                BackgroundColor="Red"
                Padding="3"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="0.9,0.1,AutoSize,AutoSize"
                AbsoluteLayout.LayoutFlags="PositionProportional">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Stroke>
                    <SolidColorBrush Color="Transparent"/>
                </Border.Stroke>

                <Label
                    x:Name="NotificationBadgeLabel"
                    Text="0"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

        </AbsoluteLayout>

    </AbsoluteLayout>

</ContentView>
