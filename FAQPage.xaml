<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NBH.FAQPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:NBH.Resources.Controls"
    xmlns:models="clr-namespace:NBH.Resources.Models"
    xmlns:viewModels="clr-namespace:NBH.Resources.ViewModels"
    xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    Title="FAQ"
    Shell.NavBarIsVisible="False"
    Padding="0"
    x:DataType="viewModels:FAQPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" HeightRequest="150" Padding="20,40,20,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource PageBackgroundStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource PageBackgroundMid}" Offset="0.5" />
                    <GradientStop Color="{StaticResource PageBackgroundEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Label Text="FAQ"
                   Style="{StaticResource DisplayStyle}"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Border>

        <!-- Ladebereich -->
        <Grid Grid.Row="1" IsVisible="{Binding IsLoading}">
            <Image Source="faq_placeholder"
                   Aspect="AspectFit"
                   HeightRequest="260"
                   Margin="24,18,24,18"/>

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 WidthRequest="220">
                <Label Text="FAQ wird geladen..."
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#00AEEF"
                       HorizontalTextAlignment="Center"/>
                <Border StrokeThickness="0"
                        BackgroundColor="#13253A"
                        HeightRequest="12"
                        Padding="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <ProgressBar x:Name="FaqLoadingProgressBar"
                                 Progress="0"
                                 ProgressColor="#00E5FF"
                                 BackgroundColor="#203C58"
                                 HeightRequest="10"/>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              IsVisible="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">

            <!-- Category Chips (fixed height, non-scrolling) -->
            <CollectionView ItemsSource="{Binding CategoryChips}"
                            SelectionMode="None"
                            HeightRequest="44"
                            Margin="16,8,16,0"
                            VerticalOptions="Start">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="12,6"
                                BackgroundColor="#F1F8F6"
                                StrokeThickness="1"
                                Stroke="#12000000">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FAQPageViewModel}}, Path=SelectCategoryChipCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding .}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#00695c"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Scrollable FAQ content using ScrollView + BindableLayout -->
            <ScrollView Margin="0,52,0,0">
                <VerticalStackLayout Spacing="8"
                                     Margin="16,0"
                                     BindableLayout.ItemsSource="{Binding VisibleCategories}">
                    <BindableLayout.EmptyView>
                        <controls:EmptyStateView
                            Title="Keine FAQ-Einträge gefunden."
                            IconSource="faq_placeholder.svg" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FAQCategory">
                            <VerticalStackLayout Spacing="6" Margin="0,4">
                                <Label Text="{Binding CategoryTitle}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#1E534B"
                                       Margin="4,2,0,2"/>

                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:FAQRow">
                                            <Border Margin="0,4"
                                                    Padding="0"
                                                    BackgroundColor="#F8FFFD"
                                                    Stroke="#12000000"
                                                    StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="Black" Opacity="0.12" Radius="12" Offset="0,4"/>
                                                </Border.Shadow>
                                                <toolkit:Expander>
                                                    <toolkit:Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                                                            <VerticalStackLayout Spacing="6">
                                                                <Label Text="{Binding Subtitle}"
                                                                       Style="{StaticResource BodyLargeStyle}"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center"/>
                                                                <Border BackgroundColor="#EAF5F2"
                                                                        Padding="8,2"
                                                                        HorizontalOptions="Start"
                                                                        StrokeThickness="0">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="10"/>
                                                                    </Border.StrokeShape>
                                                                    <Label Text="{Binding CategoryTitle}"
                                                                           FontSize="10"
                                                                           FontAttributes="Bold"
                                                                           TextColor="#1E6A5D"/>
                                                                </Border>
                                                            </VerticalStackLayout>
                                                            <Image Grid.Column="1"
                                                                   Source="chevron_down.png"
                                                                   WidthRequest="18"
                                                                   HeightRequest="18"
                                                                   Rotation="-90"
                                                                   VerticalOptions="Center"
                                                                   HorizontalOptions="Center">
                                                                <Image.Triggers>
                                                                    <DataTrigger TargetType="Image"
                                                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}"
                                                                                 Value="True">
                                                                        <Setter Property="Rotation" Value="0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Image"
                                                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}"
                                                                                 Value="False">
                                                                        <Setter Property="Rotation" Value="-90"/>
                                                                    </DataTrigger>
                                                                </Image.Triggers>
                                                            </Image>
                                                        </Grid>
                                                    </toolkit:Expander.Header>

                                                    <VerticalStackLayout Padding="14,0,14,14" Spacing="8">
                                                        <idk:MarkdownView MarkdownText="{Binding RenderMarkdown}" />
                                                    </VerticalStackLayout>
                                                </toolkit:Expander>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- TabBar placeholder (if app uses custom tab bar) -->
        <controls:CustomTabBar Grid.Row="2" SelectedIndex="4" />

    </Grid>
</ContentPage>
